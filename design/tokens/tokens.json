{
  "$description": "Kindred design tokens (DTCG format). Source of truth for src/design/tokens.ts (generated) and the future web app. Every value marked placeholder awaits the approved Figma export (Section 10 criterion 3; ADR 0022). Placeholders are never final designs.",
  "$extensions": {
    "kindred": {
      "source": "placeholder",
      "figmaExport": null,
      "contrastPairs": [
        { "foreground": "color.text.primary", "background": "color.surface.background", "usage": "Body text and field labels on the page", "minimum": 4.5 },
        { "foreground": "color.text.secondary", "background": "color.surface.background", "usage": "Supporting text and helper copy", "minimum": 4.5 },
        { "foreground": "color.text.link", "background": "color.surface.background", "usage": "Forgot your password link", "minimum": 4.5 },
        { "foreground": "color.text.onPrimary", "background": "color.action.primary", "usage": "Log In button label", "minimum": 4.5 },
        { "foreground": "color.text.onSplash", "background": "color.surface.splash", "usage": "Splash wordmark and tagline", "minimum": 4.5 },
        { "foreground": "color.text.primary", "background": "color.surface.input", "usage": "Text typed into fields", "minimum": 4.5 },
        { "foreground": "color.text.placeholder", "background": "color.surface.input", "usage": "Field hints", "minimum": 4.5 },
        { "foreground": "color.border.input", "background": "color.surface.background", "usage": "Text field outline (non-text, WCAG 1.4.11)", "minimum": 3 },
        { "foreground": "color.border.focus", "background": "color.surface.background", "usage": "Focus indicator (non-text, WCAG 1.4.11)", "minimum": 3 }
      ]
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "terracotta": { "$value": "#9A4A2C", "$description": "Mockup 'terracotta', darkened for white text (observation 1). Exact value pending.", "$extensions": { "kindred": { "status": "placeholder" } } },
      "terracottaDeep": { "$value": "#7E3A21", "$extensions": { "kindred": { "status": "placeholder" } } },
      "apricot": { "$value": "#F6C7A1", "$description": "Mockup 'apricot' splash. Dark text is used because white on apricot fails contrast (observation 1).", "$extensions": { "kindred": { "status": "placeholder" } } },
      "cream": { "$value": "#FBF5EE", "$description": "Mockup 'cream' background.", "$extensions": { "kindred": { "status": "placeholder" } } },
      "cocoa": { "$value": "#2B1D16", "$extensions": { "kindred": { "status": "placeholder" } } },
      "cocoaSoft": { "$value": "#5A463B", "$extensions": { "kindred": { "status": "placeholder" } } },
      "stone": { "$value": "#8A776B", "$extensions": { "kindred": { "status": "placeholder" } } },
      "white": { "$value": "#FFFFFF", "$extensions": { "kindred": { "status": "placeholder" } } }
    },
    "surface": {
      "background": { "$value": "{color.brand.cream}" },
      "splash": { "$value": "{color.brand.apricot}" },
      "input": { "$value": "{color.brand.white}" }
    },
    "text": {
      "primary": { "$value": "{color.brand.cocoa}" },
      "secondary": { "$value": "{color.brand.cocoaSoft}" },
      "placeholder": { "$value": "#6B5649", "$extensions": { "kindred": { "status": "placeholder" } } },
      "link": { "$value": "{color.brand.terracottaDeep}" },
      "onPrimary": { "$value": "{color.brand.white}" },
      "onSplash": { "$value": "{color.brand.cocoa}" }
    },
    "action": {
      "primary": { "$value": "{color.brand.terracotta}" },
      "primaryPressed": { "$value": "{color.brand.terracottaDeep}" }
    },
    "border": {
      "input": { "$value": "{color.brand.stone}" },
      "focus": { "$value": "{color.brand.terracottaDeep}" }
    }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": "4px", "$extensions": { "kindred": { "status": "placeholder" } } },
    "sm": { "$value": "8px", "$extensions": { "kindred": { "status": "placeholder" } } },
    "md": { "$value": "16px", "$extensions": { "kindred": { "status": "placeholder" } } },
    "lg": { "$value": "24px", "$extensions": { "kindred": { "status": "placeholder" } } },
    "xl": { "$value": "32px", "$extensions": { "kindred": { "status": "placeholder" } } },
    "xxl": { "$value": "48px", "$extensions": { "kindred": { "status": "placeholder" } } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "12px", "$extensions": { "kindred": { "status": "placeholder" } } }
  },
  "size": {
    "$type": "dimension",
    "touchTarget": { "$value": "48px", "$description": "Minimum touch target (WCAG 2.5.8 needs 24px; 48px matches platform guidance).", "$extensions": { "kindred": { "status": "placeholder" } } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": "System", "$description": "Font families are not finalized in the Brand Foundation. The platform system font stands in.", "$extensions": { "kindred": { "status": "placeholder" } } }
    },
    "size": {
      "$type": "dimension",
      "body": { "$value": "17px", "$extensions": { "kindred": { "status": "placeholder" } } },
      "label": { "$value": "16px", "$extensions": { "kindred": { "status": "placeholder" } } },
      "caption": { "$value": "15px", "$extensions": { "kindred": { "status": "placeholder" } } },
      "title": { "$value": "28px", "$extensions": { "kindred": { "status": "placeholder" } } },
      "wordmark": { "$value": "44px", "$extensions": { "kindred": { "status": "placeholder" } } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400, "$extensions": { "kindred": { "status": "placeholder" } } },
      "semibold": { "$value": 600, "$extensions": { "kindred": { "status": "placeholder" } } },
      "bold": { "$value": 700, "$extensions": { "kindred": { "status": "placeholder" } } }
    }
  }
}

{
  "$description": "Kindred design tokens (DTCG format). Source of truth for src/design/tokens.ts (generated) and the future web app. Values come from docs/design/m1-figma-brief.md: status \"approved\" is a founder-approved value (brand identity, the approved accessibility corrections B1 and B2, and the approved control specification); status \"default\" is an implementation default documented in that brief, never a founder-approved design (ADR 0022).",
  "$extensions": {
    "kindred": {
      "source": "docs/design/m1-figma-brief.md (baseline approved 2026-10-17)",
      "figmaExport": null,
      "contrastPairs": [
        { "foreground": "color.text.primary", "background": "color.surface.background", "usage": "Wordmark, tagline and field labels on the page", "minimum": 4.5 },
        { "foreground": "color.text.onSplash", "background": "color.surface.splash", "usage": "Splash wordmark and tagline", "minimum": 4.5 },
        { "foreground": "color.text.link", "background": "color.surface.background", "usage": "Forgot your password? link", "minimum": 4.5 },
        { "foreground": "color.text.primary", "background": "color.surface.input", "usage": "Text typed into fields", "minimum": 4.5 },
        { "foreground": "color.text.onPrimary", "background": "color.action.primary", "usage": "Log In button label (Inter Medium 20 is normal text)", "minimum": 4.5 },
        { "foreground": "color.text.onPrimary", "background": "color.action.primaryPressed", "usage": "Log In button label while pressed", "minimum": 4.5 },
        { "foreground": "color.action.primary", "background": "color.surface.background", "usage": "Log In button against the page (non-text, WCAG 1.4.11)", "minimum": 3 },
        { "foreground": "color.border.input", "background": "color.surface.background", "usage": "Field outline against the page (non-text, WCAG 1.4.11)", "minimum": 3 },
        { "foreground": "color.border.input", "background": "color.surface.input", "usage": "Field outline against the field (non-text, WCAG 1.4.11)", "minimum": 3 },
        { "foreground": "color.border.focus", "background": "color.surface.background", "usage": "Focused field outline against the page (non-text, WCAG 1.4.11)", "minimum": 3 },
        { "foreground": "color.border.focus", "background": "color.surface.input", "usage": "Focused field outline against the field (non-text, WCAG 1.4.11)", "minimum": 3 }
      ]
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "terracotta": { "$value": "#C96A4A", "$description": "Primary Terracotta, Kindred's primary brand colour.", "$extensions": { "kindred": { "status": "approved" } } },
      "terracottaButton": { "$value": "#A94F32", "$description": "Accessible button variant (B1, approved 2026-10-17): the fill of primary buttons carrying white text, and the focused field border (founder decision 2026-10-18). Not a replacement for the brand colour.", "$extensions": { "kindred": { "status": "approved" } } },
      "apricot": { "$value": "#F4B183", "$description": "Secondary Apricot. Not used on the Milestone 1 screens; a fill behind Charcoal text only, never text or a control's only boundary.", "$extensions": { "kindred": { "status": "approved" } } },
      "warmWhite": { "$value": "#FCFBF8", "$description": "Background Warm White.", "$extensions": { "kindred": { "status": "approved" } } },
      "white": { "$value": "#FFFFFF", "$description": "Surface White.", "$extensions": { "kindred": { "status": "approved" } } },
      "charcoal": { "$value": "#2F2F2F", "$description": "Text Charcoal.", "$extensions": { "kindred": { "status": "approved" } } },
      "sage": { "$value": "#A8CFA0", "$description": "Success Sage. Not used on the Milestone 1 screens; a fill behind Charcoal text only.", "$extensions": { "kindred": { "status": "approved" } } },
      "inputBorder": { "$value": "#E5E7EB", "$description": "Original Figma input border, recorded as the design value. Replaced for fields by color.border.input (B2).", "$extensions": { "kindred": { "status": "approved" } } }
    },
    "surface": {
      "background": { "$value": "{color.brand.warmWhite}", "$extensions": { "kindred": { "status": "approved" } } },
      "splash": { "$value": "{color.brand.warmWhite}", "$description": "Splash and native launch screen background.", "$extensions": { "kindred": { "status": "approved" } } },
      "input": { "$value": "{color.brand.white}", "$extensions": { "kindred": { "status": "approved" } } }
    },
    "text": {
      "primary": { "$value": "{color.brand.charcoal}", "$extensions": { "kindred": { "status": "approved" } } },
      "onSplash": { "$value": "{color.brand.charcoal}", "$extensions": { "kindred": { "status": "approved" } } },
      "onPrimary": { "$value": "{color.brand.white}", "$extensions": { "kindred": { "status": "approved" } } },
      "link": { "$value": "{color.brand.charcoal}", "$description": "Charcoal, underlined: Terracotta text would be 3.60:1 and fail.", "$extensions": { "kindred": { "status": "default" } } }
    },
    "action": {
      "primary": { "$value": "{color.brand.terracottaButton}", "$extensions": { "kindred": { "status": "approved" } } },
      "primaryPressed": { "$value": "#98472D", "$description": "#A94F32 darkened about 10% for pressed feedback.", "$extensions": { "kindred": { "status": "default" } } }
    },
    "border": {
      "input": { "$value": "#767676", "$description": "Field border (B2, approved 2026-10-17).", "$extensions": { "kindred": { "status": "approved" } } },
      "focus": { "$value": "{color.brand.terracottaButton}", "$description": "Focused field border #A94F32, shown together with the 2 pt width (founder decision 2026-10-18; supersedes Terracotta #C96A4A approved 2026-10-17).", "$extensions": { "kindred": { "status": "approved" } } }
    }
  },
  "space": {
    "$type": "dimension",
    "controlPaddingX": { "$value": "24px", "$description": "Button and field horizontal padding.", "$extensions": { "kindred": { "status": "approved" } } },
    "controlPaddingY": { "$value": "14px", "$description": "Button and field vertical padding.", "$extensions": { "kindred": { "status": "approved" } } },
    "controlGap": { "$value": "10px", "$description": "Button and field auto-layout gap.", "$extensions": { "kindred": { "status": "approved" } } },
    "screenMargin": { "$value": "24px", "$description": "Side margins.", "$extensions": { "kindred": { "status": "default" } } },
    "brandGap": { "$value": "8px", "$description": "Wordmark to tagline.", "$extensions": { "kindred": { "status": "default" } } },
    "brandToForm": { "$value": "48px", "$description": "Tagline to the Username row on Log In. Not in the handoff; replace with the Figma value (P1).", "$extensions": { "kindred": { "status": "default" } } },
    "row": { "$value": "16px", "$description": "Between form rows.", "$extensions": { "kindred": { "status": "default" } } },
    "label": { "$value": "12px", "$description": "Between a label and its field, beside or above it.", "$extensions": { "kindred": { "status": "default" } } },
    "beforeButton": { "$value": "24px", "$extensions": { "kindred": { "status": "default" } } },
    "beforeLink": { "$value": "16px", "$extensions": { "kindred": { "status": "default" } } },
    "screenVertical": { "$value": "32px", "$description": "Minimum space above and below the centred content inside the safe area.", "$extensions": { "kindred": { "status": "default" } } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "12px", "$extensions": { "kindred": { "status": "approved" } } }
  },
  "size": {
    "$type": "dimension",
    "touchTarget": { "$value": "48px", "$description": "Minimum touch target (handoff rule; WCAG 2.5.8 needs 24px).", "$extensions": { "kindred": { "status": "approved" } } },
    "border": { "$value": "1px", "$description": "Resting field border.", "$extensions": { "kindred": { "status": "approved" } } },
    "borderFocus": { "$value": "2px", "$description": "Focused field border (approved 2026-10-17).", "$extensions": { "kindred": { "status": "approved" } } },
    "minFieldWidth": { "$value": "160px", "$description": "Labels stack above their fields when a label and a field this wide no longer fit on one line.", "$extensions": { "kindred": { "status": "default" } } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": "Inter", "$description": "Bundled with the app (SIL Open Font License 1.1) in weights 400, 500, 600 and 700.", "$extensions": { "kindred": { "status": "approved" } } }
    },
    "size": {
      "$type": "dimension",
      "display": { "$value": "56px", "$extensions": { "kindred": { "status": "approved" } } },
      "h1": { "$value": "40px", "$extensions": { "kindred": { "status": "approved" } } },
      "h2": { "$value": "32px", "$extensions": { "kindred": { "status": "approved" } } },
      "h3": { "$value": "24px", "$extensions": { "kindred": { "status": "approved" } } },
      "body": { "$value": "16px", "$extensions": { "kindred": { "status": "approved" } } },
      "caption": { "$value": "14px", "$extensions": { "kindred": { "status": "approved" } } },
      "wordmark": { "$value": "64px", "$extensions": { "kindred": { "status": "approved" } } },
      "tagline": { "$value": "24px", "$extensions": { "kindred": { "status": "approved" } } },
      "button": { "$value": "20px", "$extensions": { "kindred": { "status": "approved" } } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400, "$extensions": { "kindred": { "status": "approved" } } },
      "medium": { "$value": 500, "$extensions": { "kindred": { "status": "approved" } } },
      "semibold": { "$value": 600, "$extensions": { "kindred": { "status": "approved" } } },
      "bold": { "$value": 700, "$extensions": { "kindred": { "status": "approved" } } }
    },
    "lineHeight": {
      "$type": "number",
      "heading": { "$value": 1.2, "$description": "Multiplier for text 20 pt and larger.", "$extensions": { "kindred": { "status": "default" } } },
      "body": { "$value": 1.5, "$description": "Multiplier for text 16 pt and smaller.", "$extensions": { "kindred": { "status": "default" } } }
    }
  },
  "scale": {
    "$type": "number",
    "wordmarkMax": { "$value": 1.5, "$description": "The wordmark grows with the system text size up to 1.5x, then shrinks to fit its line.", "$extensions": { "kindred": { "status": "default" } } }
  },
  "motion": {
    "$type": "duration",
    "splash": { "$value": 1500, "$description": "Milliseconds on the splash before Log In.", "$extensions": { "kindred": { "status": "default" } } }
  }
}

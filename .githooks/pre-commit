#!/bin/sh
# Local secret hook (Section 3). CI scans only after a push, so this catches a
# secret before it ever leaves the machine. Installed by `npm run setup`, which
# sets `git config core.hooksPath .githooks`.
#
# Fails closed: if gitleaks is not installed, the commit is refused with
# instructions rather than silently skipped.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the secret scan cannot run." >&2
  echo "Install it (see README, 'Prerequisites') and commit again." >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
status=$?
if [ $status -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: gitleaks found a possible secret in the staged changes." >&2
  echo "Remove it, rotate it if it was real, and commit again." >&2
  exit $status
fi

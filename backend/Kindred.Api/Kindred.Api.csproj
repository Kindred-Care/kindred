<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>kindred-api-local</UserSecretsId>
    <!-- The build writes the OpenAPI document to docs/api/openapi.json (Section 3, Refinement 2). -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../docs/api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kindred.Application\Kindred.Application.csproj" />
    <ProjectReference Include="..\Kindred.Infrastructure\Kindred.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kindred.UnitTests" />
    <InternalsVisibleTo Include="Kindred.IntegrationTests" />
    <InternalsVisibleTo Include="Kindred.ArchitectureTests" />
  </ItemGroup>
</Project>

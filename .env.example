# Local development configuration. Copy to .env with `npm run setup` (never commit .env).
# Every variable the stack reads is listed here. Values are local-only placeholders: the
# "local-dev-only-" passwords are allowlisted by gitleaks and must never be used anywhere else.
# Milestone 1 is local only: there are no cloud credentials, and none may be added here.

# --- Environment guard -------------------------------------------------------
# Development and seed scripts refuse to run unless this is exactly "Local" (Section 3).
KINDRED_ENVIRONMENT=Local

# --- PostgreSQL (docker compose service "db") -------------------------------
# PostgreSQL 18, the latest major version GA on Amazon RDS (decision 35, ADR 0019).
POSTGRES_DB=kindred
POSTGRES_USER=kindred_bootstrap
POSTGRES_PASSWORD=local-dev-only-bootstrap
# Host port for the database. Change it if 5432 is already in use on your machine.
KINDRED_DB_PORT=5432

# Migration role: owns the schema, runs migrations. Used only by the "migrate" service.
KINDRED_DB_MIGRATOR_PASSWORD=local-dev-only-migrator
# Application role: what the API connects as. Cannot change the schema.
KINDRED_DB_APP_PASSWORD=local-dev-only-app

# --- API ---------------------------------------------------------------------
# ASP.NET Core environment name used for local runs.
ASPNETCORE_ENVIRONMENT=Local
# Host port for the API (http://localhost:5080/v1/health).
KINDRED_API_PORT=5080

# --- Mobile app (Expo) -------------------------------------------------------
# Base URL the app uses for the API. Android emulators reach the host at 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5080
